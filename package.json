{
  "name": "friedliver",
  "productName": "FriedLiver",
  "version": "0.2.0",
  "private": true,
  "description": "A light IDE with Claude, GPT and Gemini coding agents, signed in through their own CLIs.",
  "license": "UNLICENSED",
  "main": "dist/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "start": "node esbuild.mjs && electron .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "acp:hello": "node esbuild.mjs && node dist/acp-hello.js",
    "bench:ram": "node esbuild.mjs && node dist/ram-benchmark.js",
    "dist": "node esbuild.mjs --production && electron-builder",
    "dist:dir": "node esbuild.mjs --production && electron-builder --dir"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.15"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "^1.8.0",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@types/node": "^22.20.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "monaco-editor": "^0.57.0",
    "playwright": "^1.64.1",
    "preact": "^11.0.1",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "dev.friedliver.app",
    "productName": "FriedLiver",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "!dist/**/*.map",
      "!dist/acp-hello.js",
      "!dist/ram-benchmark.js",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@lydell/**"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "FriedLiver",
      "syncDesktopName": true
    }
  },
  "desktopName": "friedliver.desktop"
}
