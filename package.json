{
  "name": "friedliver",
  "productName": "FriedLiver",
  "version": "0.1.0",
  "private": true,
  "description": "A light IDE with Claude, GPT and Gemini coding agents, signed in through their own CLIs.",
  "license": "UNLICENSED",
  "main": "dist/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "start": "node esbuild.mjs && electron .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "acp:hello": "node esbuild.mjs && node dist/acp-hello.js",
    "bench:ram": "node esbuild.mjs && node dist/ram-benchmark.js"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "electron": "^44.8.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "monaco-editor": "^0.57.0",
    "playwright": "^1.64.1",
    "preact": "^11.0.1",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
